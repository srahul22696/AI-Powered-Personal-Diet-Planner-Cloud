# ---------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub.
# ---------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database (local simulation of a cloud DB like Firestore)
DATABASE_URL=sqlite:///cloud_diet_planner.db

# Cloud storage (local simulation of Firebase Storage / S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage_data

# Optional: real cloud storage credentials (only needed if STORAGE_BACKEND=firebase or s3)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Optional: external AI API for diet plan generation (falls back to rule-based engine if unset/fails)
AI_API_KEY=
AI_API_URL=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
